# Copy this file to terraform.tfvars and fill in your values.
# Never commit terraform.tfvars — it contains project-specific config.

# ---- Required ----
project_id = "your-gcp-project-id"
run_id     = "run-20250521"

# ---- Location (defaults to europe-west1-b) ----
# region = "us-central1"
# zone   = "us-central1-a"

# ---- Machine ----
# CPU-only, small (fast/cheap for testing)
machine_type = "n1-standard-4"
disk_size_gb = 100
spot         = true

# GPU example (uncomment to use):
# machine_type = "n1-standard-8"
# gpu_type     = "nvidia-tesla-t4"
# gpu_count    = 1

# ---- Scale ----
worker_count = 1

# ---- Models to pull at boot ----
models_to_pull = [
  "deepseek-coder:6.7b",
  "qwen2.5-coder:7b",
  "llama3.1:8b",
]

# ---- Distributed mode ----
# Leave empty for standalone. Set to your controller's public URL for distributed mode.
# controller_url = "https://your-ngrok-or-cloudflare-url.example.com"

# ---- SSH access ----
# Restrict to your IP for security: "1.2.3.4/32"
# allowed_ssh_cidrs = ["0.0.0.0/0"]
