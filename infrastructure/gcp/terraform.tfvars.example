# Copy this file to terraform.tfvars and fill in your values.
# terraform.tfvars is gitignored — never commit it (contains auth key).

# ---- Required ----
project_id = "your-gcp-project-id"
run_id     = "run-20250521"

# ---- Tailscale ----
# Generate at https://login.tailscale.com/admin/settings/keys
# Settings: Reusable ✓  Ephemeral ✓
# Alternatively, set via env var to avoid storing in file:
#   export TF_VAR_tailscale_auth_key="tskey-auth-..."
tailscale_auth_key = "tskey-auth-xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ---- Controller ----
# Your machine's Tailscale IP (run: tailscale ip -4)
controller_url = "http://100.74.25.30:8000"

# ---- Location ----
# region = "europe-west1"
# zone   = "europe-west1-b"

# ---- Machine ----
machine_type = "n1-standard-4"
disk_size_gb = 100
spot         = true

# GPU example:
# machine_type = "n1-standard-8"
# gpu_type     = "nvidia-tesla-t4"
# gpu_count    = 1

# ---- Scale ----
worker_count = 1

# ---- Models ----
models_to_pull = [
  "deepseek-coder:6.7b",
  "qwen2.5-coder:7b",
]

# ---- SSH access (optional, restrict to your Tailscale IP) ----
# allowed_ssh_cidrs = ["100.74.25.30/32"]
